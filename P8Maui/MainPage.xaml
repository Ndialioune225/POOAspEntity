<?xml version="1.0" encoding="utf-8" ?>
<!-- Page "Personnes" : ajout, affichage et suppression de personnes stockées dans SQLite.
     x:DataType active les liaisons compilées (vérifiées à la compilation). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:P8Maui.ViewModels"
             xmlns:models="clr-namespace:P8Maui.Models"
             x:Class="P8Maui.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Personnes">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
          RowSpacing="12"
          Padding="20">

        <Label Grid.Row="0" Text="Gestion des personnes" Style="{StaticResource PageTitle}" />

        <!-- Saisie + bouton Ajouter -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Entry Grid.Column="0"
                   Placeholder="Nom de la personne"
                   Text="{Binding NewName}"
                   ReturnCommand="{Binding AddCommand}" />
            <Button Grid.Column="1"
                    Text="Ajouter"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddCommand}" />
        </Grid>

        <Button Grid.Row="2"
                Text="Afficher / actualiser la liste"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding LoadCommand}" />

        <Label Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource StatusLabel}" />

        <!-- Liste des personnes -->
        <CollectionView Grid.Row="4" ItemsSource="{Binding People}">
            <CollectionView.EmptyView>
                <Label Text="Aucune personne pour l'instant." HorizontalOptions="Center" Margin="0,20" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Person">
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{Binding Id, StringFormat='#{0}'}" Style="{StaticResource MutedLabel}" />
                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="16" VerticalOptions="Center" />
                            <!-- La commande est celle du ViewModel de la page : on remonte jusqu'à lui
                                 avec RelativeSource, et on passe la personne en paramètre. -->
                            <Button Grid.Column="2"
                                    Text="Supprimer"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=DeleteCommand, x:DataType=vm:MainViewModel}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
